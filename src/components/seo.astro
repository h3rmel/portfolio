---
import { getValidLocale } from '@/i18n/utils';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  structuredData?: Record<string, any>;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-image.png',
  ogType = 'website',
  noindex = false,
  structuredData,
} = Astro.props;

const locale = Astro.currentLocale;
const validLocale = getValidLocale(locale);
const lang = validLocale === 'pt' ? 'pt-BR' : 'en-US';
const siteUrl = 'https://isaachermel.dev.br';
const canonicalURL = canonical || new URL(Astro.url.pathname, siteUrl).href;
const imageURL = new URL(ogImage, siteUrl).href;

// Person Structured Data
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Isaac Hermel Reginato',
  jobTitle: 'Software Engineer',
  url: siteUrl,
  sameAs: [
    'https://github.com/h3rmel',
    'https://www.linkedin.com/in/isaachermel/',
    'https://x.com/isaach3rmel',
  ],
  knowsAbout: [
    'TypeScript',
    'React',
    'Next.js',
    'Node.js',
    'Software Engineering',
    'Frontend Development',
    'Full Stack Development',
  ],
  alumniOf: [
    {
      '@type': 'EducationalOrganization',
      name: 'Descomplica',
    },
    {
      '@type': 'EducationalOrganization',
      name: 'Instituto Federal Sul-rio-grandense',
    },
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'Zenvia',
  },
};

const combinedStructuredData = structuredData || personSchema;
---

<!-- Primary Meta Tags -->
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Isaac Hermel Reginato" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Alternate Languages -->
<link
  rel="alternate"
  hreflang="en"
  href={`${siteUrl}/en${Astro.url.pathname.replace(/^\/(en|pt)/, '')}`}
/>
<link
  rel="alternate"
  hreflang="pt"
  href={`${siteUrl}/pt${Astro.url.pathname.replace(/^\/(en|pt)/, '')}`}
/>
<link
  rel="alternate"
  hreflang="x-default"
  href={`${siteUrl}/en${Astro.url.pathname.replace(/^\/(en|pt)/, '')}`}
/>

<!-- Robots -->
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:locale" content={lang} />
<meta property="og:site_name" content="Isaac Hermel Reginato" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:creator" content="@isaach3rmel" />
<meta name="twitter:site" content="@isaach3rmel" />

<!-- Theme Color -->
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(combinedStructuredData)} />
