---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { IconBrandGithub, IconBrandLinkedin, IconBrandX } from '@tabler/icons-react';
import { CV_URL, SOCIAL_LINKS } from '@/config/links';
import { getTranslations, getValidLocale } from '@/i18n/utils';
import { Avatar } from '../avatar';
import { LinksList } from '../links-list';
import { LinksListItem } from '../links-list-item';
import { LocaleToggle } from '../locale-toggle';
import { AnimatedThemeToggler } from '../ui/animated-theme-toggler';
import { FlickeringGrid } from '../ui/flickering-grid';
import { LightRays } from '../ui/light-rays';

interface Props {
  locale: string | undefined;
}

const { locale } = Astro.props;
const validLocale = getValidLocale(locale);
const t = getTranslations(locale);

const aboutUrl = getRelativeLocaleUrl(validLocale, 'about');
const projectsUrl = getRelativeLocaleUrl(validLocale, 'projects');
---

<main class="relative flex min-h-dvh w-full items-center justify-center overflow-hidden">
  <FlickeringGrid
    client:idle
    className="absolute inset-0 top-0 left-0 z-0 size-full [mask-image:radial-gradient(480px_circle_at_center,white,transparent)]"
    squareSize={4}
    gridGap={6}
    width={1920}
    height={1080}
    maxOpacity={0.3}
    color={{ light: '#000000', dark: '#ffffff' }}
    flickerChance={0.1}
  />
  <div class="absolute top-4 right-4 flex gap-4">
    <LocaleToggle client:idle />
    <AnimatedThemeToggler client:idle />
  </div>
  <section class="z-10 flex w-full flex-col space-y-10 p-4 lg:max-w-md lg:p-0">
    <!-- First Impression -->
    <div class="flex flex-col items-center space-y-4">
      <div>
        <Avatar client:idle />
      </div>
      <h1 class="text-muted-foreground space-y-2 text-center text-base lg:text-justify">
        <span class="text-foreground block font-bold italic">
          {t.home.greeting}
        </span>
        <span class="block">
          {t.home.subtitle}
        </span>
      </h1>
    </div>
    <!-- Links -->
    <LinksList className="flex flex-col space-y-4">
      <LinksListItem href={aboutUrl} icon="IconChevronRight">
        {t.home.about}
      </LinksListItem>
      <LinksListItem href={projectsUrl} icon="IconChevronRight">
        {t.home.projects}
      </LinksListItem>
      <LinksListItem
        target="_blank"
        linkClassName=" hover:[&_svg]:translate-x-0"
        href={CV_URL[validLocale]}
        icon="IconExternalLink"
      >
        {t.home.cv}
      </LinksListItem>
    </LinksList>
    <!-- Socials -->
    <LinksList className="flex flex-row space-x-4">
      <LinksListItem
        className="w-full"
        linkClassName="justify-center hover:[&_svg]:translate-x-0"
        href={SOCIAL_LINKS.github}
        target="_blank"
        ariaLabel="GitHub"
      >
        <IconBrandGithub className="size-4" />
      </LinksListItem>
      <LinksListItem
        className="w-full"
        linkClassName="justify-center hover:[&_svg]:translate-x-0"
        href={SOCIAL_LINKS.linkedin}
        target="_blank"
        ariaLabel="LinkedIn"
      >
        <IconBrandLinkedin className="size-4" />
      </LinksListItem>
      <LinksListItem
        className="w-full"
        linkClassName="justify-center hover:[&_svg]:translate-x-0"
        href={SOCIAL_LINKS.x}
        target="_blank"
        ariaLabel="X"
      >
        <IconBrandX className="size-4" />
      </LinksListItem>
    </LinksList>
  </section>
</main>
