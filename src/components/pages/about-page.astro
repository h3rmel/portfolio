---
import { Image } from 'astro:assets';
import { CAREER_LOGOS } from '@/config/career';
import { EDUCATION_LOGOS } from '@/config/education';
import { getTranslations } from '@/i18n/utils';
import { Separator } from '../ui/separator';

interface Props {
  locale: string | undefined;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<!-- About me -->
<article class="flex flex-col space-y-10">
  <hgroup class="flex flex-col">
    <h1 class="text-2xl font-bold tracking-tight">
      {t.about.title}
    </h1>
    <h6 class="text-muted-foreground text-lg">
      {t.about.subtitle}
    </h6>
  </hgroup>
  <section class="flex flex-col space-y-10">
    {
      t.about.paragraphs.map((paragraph) => (
        <p class="text-foreground text-justify text-sm leading-relaxed font-light">
          {paragraph}
        </p>
      ))
    }
  </section>
</article>
<Separator className="my-10" />
<!-- Career -->
<article class="flex flex-col space-y-10">
  <hgroup>
    <h2 class="text-2xl font-bold tracking-tight">
      {t.career.title}
    </h2>
    <h6 class="text-muted-foreground text-lg">
      {t.career.subtitle}
    </h6>
  </hgroup>
  <p class="text-foreground text-justify text-sm leading-relaxed font-light">
    {t.career.paragraph}
  </p>
  <ul class="flex flex-col space-y-4">
    {
      t.career.experiences.map((experience) => (
        <li class="group border-border bg-background/50 hover:border-accent-foreground relative flex items-start justify-between rounded-lg border border-b-3 p-2 transition-all hover:scale-[1.025] sm:p-4">
          <div class="flex items-center space-x-4">
            <Image
              class="border-border group-hover:border-accent-foreground size-14 shrink-0 rounded-full border p-0.5 transition-all sm:size-14"
              src={CAREER_LOGOS[experience.employer as keyof typeof CAREER_LOGOS]}
              alt={experience.employer}
              width={64}
              height={64}
              loading="lazy"
            />
            <div class="flex flex-col">
              <h3 class="text-lg sm:text-xl">{experience.employer}</h3>
              <p class="text-muted-foreground text-xs sm:text-sm">
                {experience.position}
              </p>
            </div>
          </div>
          <p class="text-muted-foreground absolute top-2 right-2 text-xs sm:relative sm:text-sm">
            {experience.year}
          </p>
        </li>
      ))
    }
  </ul>
</article>
<Separator className="my-10" />
<!-- Education -->
<article class="flex flex-col space-y-10">
  <hgroup class="flex flex-col">
    <h2 class="text-2xl font-bold tracking-tight">{t.education.title}</h2>
    <h6 class="text-muted-foreground text-lg">{t.education.subtitle}</h6>
  </hgroup>
  <p class="text-foreground text-justify text-sm leading-relaxed font-light">
    {t.education.paragraph}
  </p>
  <ul class="flex flex-col space-y-4">
    {
      t.education.curriculum.map((item) => (
        <li class="group border-border bg-background/50 hover:border-accent-foreground relative flex items-start justify-between rounded-lg border border-b-3 p-2 transition-all hover:scale-[1.025] sm:p-4">
          <div class="flex items-center space-x-4">
            <Image
              class="border-border group-hover:border-accent-foreground size-12 shrink-0 rounded-full border p-0.5 transition-all sm:size-14"
              src={EDUCATION_LOGOS[item.institution as keyof typeof EDUCATION_LOGOS]}
              alt={item.institution}
              width={64}
              height={64}
              loading="lazy"
            />
            <div class="flex flex-col">
              <h3 class="text-lg sm:text-xl">{item.institution}</h3>
              <p class="text-muted-foreground text-xs sm:text-sm">{item.degree}</p>
            </div>
          </div>
          <p class="text-muted-foreground absolute top-2 right-2 text-xs sm:relative sm:text-sm">
            {item.year}
          </p>
        </li>
      ))
    }
  </ul>
</article>
