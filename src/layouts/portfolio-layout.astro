---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { NavigationBar } from '@/components/layout/navigation-bar';
import { getTranslations, getValidLocale } from '@/i18n/utils';
import BaseLayout from '@/layouts/base-layout.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
}

const { title, description, ogImage, ogType, noindex } = Astro.props;
const locale = Astro.currentLocale;
const currentPath = Astro.url.pathname;
const validLocale = getValidLocale(locale);

const t = getTranslations(locale);

const navigationLinks = [
  { href: getRelativeLocaleUrl(validLocale, 'about'), label: t.navigation.about },
  { href: getRelativeLocaleUrl(validLocale, 'projects'), label: t.navigation.projects },
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType={ogType}
  noindex={noindex}
>
  <NavigationBar
    client:idle
    currentLocale={validLocale}
    navigationLinks={navigationLinks}
    currentPath={currentPath}
  />
  <main class="relative mx-auto my-12 size-full max-w-screen-lg px-4">
    <slot />
  </main>
</BaseLayout>
