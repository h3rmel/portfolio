# BiomeJS ignore file

# Ignore Astro files (not fully supported)
**/*.astro

# Ignore CSS files (Tailwind CSS not supported)
**/*.css

# Ignore build outputs
dist/
.astro/
node_modules/

# Ignore lock files
bun.lock
package-lock.json

# Ignore config files
*.config.js
*.config.mjs
*.config.ts

# Ignore public directory
public/

